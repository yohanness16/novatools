---
import '../styles/global.css';
import { Header } from '../components/Header';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import { CookieConsent } from '../components/CookieConsent';

export interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  canonicalUrl?: string;
  faqs?: { question: string; answer: string }[];
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description = 'NovaTools is a high-performance, 100% client-side document, image, video, and PDF manipulation suite. Fast, private, and local.',
  keywords = ['pdf tools', 'image converter', 'video compressor', 'client-side tools', 'local processing', 'private pdf merger', 'online media tools'],
  canonicalUrl = Astro.url.href,
  faqs = [],
  breadcrumbs = [],
} = Astro.props;

const adSenseClientId = 'ca-pub-6768212179657827';
---

<!doctype html>
<html lang="en" class="light scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Inline Theme Detection: Defaults to Warm Studio Light Mode */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('novatools-theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          }
        } catch (e) {
          document.documentElement.classList.add('light');
        }
      })();
    </script>

    {/* Primary SEO & Unified Multi-Entity Schema.org Graph */}
    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      canonicalUrl={canonicalUrl}
      faqs={faqs}
      breadcrumbs={breadcrumbs}
    />

    {/* Cross-Origin Isolation for In-Browser Multi-threaded Web Workers */}
    <meta http-equiv="Cross-Origin-Opener-Policy" content="same-origin" />
    <meta http-equiv="Cross-Origin-Embedder-Policy" content="require-corp" />

    {/* Google Fonts: Plus Jakarta Sans, JetBrains Mono & Multilingual / Ethiopic Display */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Abyssinica+SIL&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+Ethiopic:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    {/* Google AdSense Asynchronous Script Tag */}
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adSenseClientId}`}
      crossorigin="anonymous"
    ></script>
  </head>
  <body class="selection:bg-[#FACC15]/45 selection:text-[#141413] flex min-h-[100dvh] flex-col font-sans antialiased">
    {/* Desktop App Top Bar */}
    <Header client:load />

    {/* Main Content */}
    <main class="flex-1 pt-[4.5rem]">
      <slot />
    </main>

    {/* Footer */}
    <Footer />

    {/* Cookie / Preferences */}
    <CookieConsent client:idle />
  </body>
</html>
