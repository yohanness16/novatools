---
import SuiteIndexLayout from '../../components/SuiteIndexLayout.astro';
import { ShieldCheck, Layers, FileText } from 'lucide-react';
---

<SuiteIndexLayout
  category="pdf"
  title="PDF Suite - Client-Side PDF Tools | NovaTools"
  description="Merge, split, rotate, encrypt, redact, and number PDF documents directly in your browser. Zero cloud uploads, total confidentiality."
  suiteCode="PDF_SUITE"
  headingPrefix="Private, Studio-Grade"
  headingHighlight="PDF Utilities"
  summary="Manipulate confidential contracts, financial ledgers, and multi-page reports securely. All PDF parsing, decrypting, and rendering executes 100% locally inside your browser memory."
  sectionTitle="All PDF Tools"
>
  <section class="nt-card p-6 sm:p-8 space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-[var(--nt-border)] pb-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#CA8A04] dark:text-[#FACC15] font-mono">
          <FileText class="h-4 w-4" />
          <span>Architecture & Specifications</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#141413] dark:text-[#FAF7F0]">
          Client-Side PDF Engine Architecture
        </h2>
      </div>
      <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="nt-badge-yellow px-3 py-1 font-bold">Vector In-Memory Engine</span>
        <span class="rounded-full bg-[#EAE3D4] dark:bg-[#141311] text-[#454038] dark:text-[#CBC4B6] px-3 py-1 border border-[var(--nt-border)] font-semibold">
          0 Bytes Uploaded
        </span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 text-xs sm:text-sm text-[#454038] dark:text-[#CBC4B6] leading-relaxed">
      <div class="space-y-3">
        <p>
          The NovaTools PDF Suite provides surgical, high-performance manipulation for PDF documents directly inside your browser. From assembling financial reports and splitting dossiers to permanent vector page numbering and AES password protection, all operations run locally.
        </p>
        <p>
          Unlike cloud services that ingest customer files into remote servers, NovaTools processes PDFs entirely inside temporary local browser memory.
        </p>
      </div>
      <div class="space-y-3">
        <p>
          Our engine updates the PDF object graph and transformation matrices directly without lossy rasterization—preserving vector typography, links, and bookmarks.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <div class="nt-subcard p-3.5 space-y-1">
            <span class="text-xs font-bold text-[#141413] dark:text-[#FAF7F0] flex items-center gap-1.5">
              <ShieldCheck class="h-4 w-4 text-[#15803D] dark:text-[#4ADE80]" /> Air-Gapped Security
            </span>
            <p class="text-xs text-[#746D61] dark:text-[#938B7D]">Safe for legal discovery, medical charts, and compliance filings.</p>
          </div>
          <div class="nt-subcard p-3.5 space-y-1">
            <span class="text-xs font-bold text-[#141413] dark:text-[#FAF7F0] flex items-center gap-1.5">
              <Layers class="h-4 w-4 text-[#CA8A04] dark:text-[#FACC15]" /> Vector Fidelity
            </span>
            <p class="text-xs text-[#746D61] dark:text-[#938B7D]">Lossless object manipulation without re-rasterizing fonts or charts.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</SuiteIndexLayout>
