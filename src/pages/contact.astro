---
import Layout from '../layouts/Layout.astro';
import { Mail, Send, CheckCircle2 } from 'lucide-react';
---

<Layout
  title="Contact Support & Feedback - NovaTools"
  description="Have questions, suggestions, or need assistance? Contact the NovaTools development team."
>
  <div class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8 space-y-6">
    <div class="nt-window p-6 sm:p-7 space-y-3">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-[#D9A700]/40 bg-[#FEF7D6] dark:bg-[#FACC15]/15 px-3 py-1 text-xs font-mono font-bold text-[#141413] dark:text-[#FACC15]">
        <Mail class="h-3.5 w-3.5" />
        <span>Developer Support Desk</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[#141413] dark:text-[#FAF7F0]">
        Contact & System Feedback
      </h1>
      <p class="text-xs sm:text-sm text-[#454038] dark:text-[#CBC4B6]">
        Submit bug reports, feature proposals, or codec inquiries directly to the engineering team.
      </p>
    </div>

    <div class="nt-card p-6 sm:p-7">
      <form class="space-y-4" onsubmit="event.preventDefault(); document.getElementById('contact-success').classList.remove('hidden'); this.reset();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-[#141413] dark:text-[#FAF7F0]">Your Name</label>
            <input
              type="text"
              required
              placeholder="e.g. Alex"
              class="nt-input w-full px-3.5 py-2.5 text-xs"
            />
          </div>
          <div class="space-y-1.5">
            <label class="block text-xs font-bold text-[#141413] dark:text-[#FAF7F0]">Email Address</label>
            <input
              type="email"
              required
              placeholder="alex@example.com"
              class="nt-input w-full px-3.5 py-2.5 text-xs"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[#141413] dark:text-[#FAF7F0]">Category</label>
          <select class="nt-input w-full px-3.5 py-2.5 text-xs">
            <option>General Feedback / Bug Report</option>
            <option>PDF Suite Runtime Issue</option>
            <option>Image Suite / Canvas Issue</option>
            <option>Video / WebCodecs Issue</option>
            <option>Whisper Subtitle Transcription</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label class="block text-xs font-bold text-[#141413] dark:text-[#FAF7F0]">Message</label>
          <textarea
            rows="4"
            required
            placeholder="Describe the issue, reproduction steps, or format requirements..."
            class="nt-input w-full p-3.5 text-xs resize-none font-mono"
          ></textarea>
        </div>

        <div id="contact-success" class="hidden nt-badge-success rounded-xl flex items-center gap-2 p-3 text-xs font-semibold">
          <CheckCircle2 class="h-4 w-4 shrink-0" />
          <span>Message logged. We will review your note shortly.</span>
        </div>

        <button
          type="submit"
          class="w-full flex items-center justify-center gap-2 nt-btn-yellow py-3 px-4 text-xs"
        >
          <Send class="h-3.5 w-3.5" />
          <span>Submit Note</span>
        </button>
      </form>
    </div>
  </div>
</Layout>
