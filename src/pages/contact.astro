---
import Layout from '../layouts/Layout.astro';
import { Mail, Send, CheckCircle2 } from 'lucide-react';
---

<Layout
  title="Contact Support & Feedback - NovaTools"
  description="Have questions, suggestions, or need assistance? Contact the NovaTools development team."
>
  <div class="mx-auto max-w-2xl px-4 py-10 sm:px-6 lg:px-8 space-y-6">
    <div class="space-y-2 border-b border-[#2A2D33] pb-4">
      <div class="inline-flex items-center gap-1.5 rounded border border-[#4F8CFF]/30 bg-[#16233F] px-2.5 py-0.5 text-[11px] font-mono font-medium text-[#4F8CFF]">
        <Mail class="h-3.5 w-3.5" />
        <span>Developer Support Desk</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-[#ECEDEF]">Contact & System Feedback</h1>
      <p class="text-xs text-[#8B8F98]">
        Submit bug reports, feature proposals, or codec inquiries directly to the engineering team.
      </p>
    </div>

    <div class="rounded border border-[#2A2D33] bg-[#131418] p-5 sm:p-6">
      <form class="space-y-3.5" onsubmit="event.preventDefault(); document.getElementById('contact-success').classList.remove('hidden'); this.reset();">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-medium text-[#ECEDEF] mb-1">Your Name</label>
            <input
              type="text"
              required
              placeholder="e.g. Alex"
              class="w-full rounded border border-[#2A2D33] bg-[#1B1D22] px-3 py-1.5 text-xs text-[#ECEDEF] placeholder-[#5B606D] focus:border-[#4F8CFF] focus:outline-none"
            />
          </div>
          <div>
            <label class="block text-xs font-medium text-[#ECEDEF] mb-1">Email Address</label>
            <input
              type="email"
              required
              placeholder="alex@example.com"
              class="w-full rounded border border-[#2A2D33] bg-[#1B1D22] px-3 py-1.5 text-xs text-[#ECEDEF] placeholder-[#5B606D] focus:border-[#4F8CFF] focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-[#ECEDEF] mb-1">Category</label>
          <select class="w-full rounded border border-[#2A2D33] bg-[#1B1D22] px-3 py-1.5 text-xs text-[#ECEDEF] focus:border-[#4F8CFF] focus:outline-none">
            <option>General Feedback / Bug Report</option>
            <option>PDF Suite Runtime Issue</option>
            <option>Image Suite / Canvas Issue</option>
            <option>Video / WebCodecs Issue</option>
            <option>OpenAI Whisper Subtitle Transcription</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-medium text-[#ECEDEF] mb-1">Message</label>
          <textarea
            rows="4"
            required
            placeholder="Describe the issue, reproduction steps, or format requirements..."
            class="w-full rounded border border-[#2A2D33] bg-[#1B1D22] p-2.5 text-xs text-[#ECEDEF] placeholder-[#5B606D] focus:border-[#4F8CFF] focus:outline-none resize-none font-mono"
          ></textarea>
        </div>

        <div id="contact-success" class="hidden flex items-center gap-2 rounded bg-[#122D1F] border border-[#3FBE73]/40 p-3 text-xs text-[#3FBE73]">
          <CheckCircle2 class="h-4 w-4 shrink-0" />
          <span>Message logged. We will review your note shortly.</span>
        </div>

        <button
          type="submit"
          class="w-full flex items-center justify-center gap-2 rounded bg-[#4F8CFF] hover:bg-[#3B79F0] py-2 px-4 text-xs font-semibold text-white transition-colors"
        >
          <Send class="h-3.5 w-3.5" />
          <span>Submit Note</span>
        </button>
      </form>
    </div>

    <div class="rounded border border-[#2A2D33] bg-[#1B1D22] p-3 text-center text-xs text-[#8B8F98] font-mono">
      Direct Email: <a href="mailto:support@novatools.app" class="text-[#4F8CFF] hover:underline">support@novatools.app</a>
    </div>
  </div>
</Layout>
