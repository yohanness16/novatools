---
import Layout from '../layouts/Layout.astro';
import { TOOLS, CATEGORIES } from '../lib/toolsData';
import {
  Layers, Scissors, RotateCw, Lock, EyeOff, FileImage, FilePlus,
  Repeat, Minimize2, Maximize2, ShieldCheck, Code, Film, Clock, Music, VolumeX, Volume2, Subtitles,
  Shield, Cpu, HardDrive, Terminal, Search, ArrowRight, FileText, Image as ImageIcon, Video
} from 'lucide-react';

const iconMap: Record<string, any> = {
  Layers, Scissors, RotateCw, Lock, EyeOff, FileImage, FilePlus,
  Repeat, Minimize2, Maximize2, ShieldCheck, Code, Film, Clock, Music, VolumeX, Volume2, Subtitles,
  FileText
};

const categoryIcons: Record<string, any> = {
  all: Terminal,
  pdf: FileText,
  image: ImageIcon,
  video: Video,
  svg: Code,
};
---

<Layout
  title="NovaTools Console - 100% Client-Side Media & PDF Suite"
  description="High-performance, privacy-first PDF, image, video, and vector tools running locally in WebAssembly. Zero server uploads."
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 space-y-8">
    {/* Console Header & Telemetry Strip */}
    <div class="rounded-lg border border-[#2A2D33] bg-[#131418] p-5 sm:p-7 space-y-5">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-[#2A2D33] pb-5">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-[#3FBE73]" />
            <span class="font-mono text-[11px] uppercase tracking-wider text-[#8B8F98]">
              Local Engine Online
            </span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#ECEDEF]">
            NovaTools Service Catalog
          </h1>
          <p class="text-xs sm:text-sm text-[#8B8F98] max-w-2xl">
            21 document, image, audio, and video utility engines running 100% client-side in your browser. Zero cloud uploads, zero data retention, zero quotas.
          </p>
        </div>

        {/* Telemetry Stat Chips */}
        <div class="flex flex-wrap items-center gap-2">
          <div className="flex items-center gap-2 font-mono text-[11px] text-[#8B8F98] bg-[#1B1D22] px-3 py-1.5 rounded border border-[#2A2D33]">
            <HardDrive className="h-3.5 w-3.5 text-[#4F8CFF]" />
            <span>Uploads: <strong class="text-[#3FBE73]">0 Bytes</strong></span>
          </div>
          <div className="flex items-center gap-2 font-mono text-[11px] text-[#8B8F98] bg-[#1B1D22] px-3 py-1.5 rounded border border-[#2A2D33]">
            <Cpu className="h-3.5 w-3.5 text-[#4F8CFF]" />
            <span>Runtime: <strong class="text-[#ECEDEF]">WebAssembly</strong></span>
          </div>
        </div>
      </div>

      {/* Suite Filter Bar */}
      <div class="flex flex-wrap items-center gap-2">
        {CATEGORIES.map((cat) => {
          const CatIcon = categoryIcons[cat.id] || Terminal;
          return (
            <a
              href={cat.id === 'all' ? '/' : `/#${cat.id}-suite`}
              class={`flex items-center gap-2 px-3 py-1.5 rounded text-xs font-medium border transition-colors ${
                cat.id === 'all'
                  ? 'bg-[#16233F] text-[#4F8CFF] border-[#4F8CFF]/40'
                  : 'bg-[#1B1D22] text-[#8B8F98] border-[#2A2D33] hover:text-[#ECEDEF] hover:border-[#4F8CFF]/30'
              }`}
            >
              <CatIcon class="h-3.5 w-3.5" />
              <span>{cat.label}</span>
              <span class="font-mono text-[10px] text-[#5B606D]">({cat.count})</span>
            </a>
          );
        })}
      </div>
    </div>

    {/* Tool Suite Sections */}
    {CATEGORIES.filter(c => c.id !== 'all').map((cat) => {
      const suiteTools = TOOLS.filter(t => t.category === cat.id);
      const CatIcon = categoryIcons[cat.id] || Terminal;

      return (
        <section id={`${cat.id}-suite`} class="space-y-4 pt-2">
          {/* Section Header */}
          <div class="flex items-center justify-between border-b border-[#2A2D33] pb-2.5">
            <div class="flex items-center gap-2">
              <div class="flex h-6 w-6 items-center justify-center rounded bg-[#1B1D22] border border-[#2A2D33] text-[#4F8CFF]">
                <CatIcon class="h-3.5 w-3.5" />
              </div>
              <h2 class="text-sm font-semibold uppercase tracking-wider text-[#ECEDEF]">
                {cat.label}
              </h2>
              <span class="font-mono text-xs text-[#5B606D]">
                ({suiteTools.length} utilities)
              </span>
            </div>

            <span class="font-mono text-[11px] text-[#8B8F98]">100% Local WASM</span>
          </div>

          {/* Tools Grid */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
            {suiteTools.map((tool) => {
              const Icon = iconMap[tool.iconName] || FileText;

              return (
                <a
                  href={tool.path}
                  class="group flex flex-col justify-between rounded-lg border border-[#2A2D33] bg-[#131418] p-4 transition-all hover:border-[#4F8CFF] hover:bg-[#16171D]"
                >
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <div class="flex h-8 w-8 items-center justify-center rounded bg-[#1B1D22] border border-[#2A2D33] text-[#8B8F98] group-hover:text-[#4F8CFF] group-hover:border-[#4F8CFF]/40 transition-colors">
                        <Icon class="h-4 w-4" />
                      </div>

                      {tool.badge && (
                        <span class="font-mono text-[10px] font-medium text-[#4F8CFF] bg-[#16233F] px-2 py-0.5 rounded border border-[#4F8CFF]/20">
                          {tool.badge}
                        </span>
                      )}
                    </div>

                    <div class="space-y-1">
                      <h3 class="text-sm font-semibold text-[#ECEDEF] group-hover:text-[#4F8CFF] transition-colors">
                        {tool.name}
                      </h3>
                      <p class="text-xs text-[#8B8F98] line-clamp-2 leading-relaxed">
                        {tool.description}
                      </p>
                    </div>
                  </div>

                  <div class="flex items-center justify-between pt-4 mt-2 border-t border-[#2A2D33]/60 font-mono text-[10px] text-[#5B606D]">
                    <span>Local WASM</span>
                    <span class="flex items-center gap-1 text-[#8B8F98] group-hover:text-[#4F8CFF] transition-colors">
                      Open Tool <ArrowRight class="h-3 w-3" />
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}

    {/* Architecture & Security Ledger */}
    <section class="rounded-lg border border-[#2A2D33] bg-[#131418] p-6 space-y-4">
      <div class="flex items-center gap-2 border-b border-[#2A2D33] pb-3 text-xs font-semibold uppercase tracking-wider text-[#ECEDEF]">
        <Terminal class="h-4 w-4 text-[#4F8CFF]" />
        <span>Technical Architecture & Privacy Ledger</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="rounded bg-[#1B1D22] p-4 border border-[#2A2D33] space-y-1.5">
          <div class="font-semibold text-[#ECEDEF]">Zero Server Uploads</div>
          <p class="text-[#8B8F98] leading-relaxed">
            All file decoding, image compression, video frame extraction, and PDF manipulation execute in memory using WebAssembly and HTML5 Canvas.
          </p>
        </div>

        <div class="rounded bg-[#1B1D22] p-4 border border-[#2A2D33] space-y-1.5">
          <div class="font-semibold text-[#ECEDEF]">Client-Side AI Inference</div>
          <p class="text-[#8B8F98] leading-relaxed">
            Whisper speech-to-text and background removal run locally via ONNX WebAssembly runtimes with $0 cloud infrastructure costs.
          </p>
        </div>

        <div class="rounded bg-[#1B1D22] p-4 border border-[#2A2D33] space-y-1.5">
          <div class="font-semibold text-[#ECEDEF]">No File Size Limits</div>
          <p class="text-[#8B8F98] leading-relaxed">
            Files are not bounded by slow internet upload speeds or cloud storage quotas; throughput is bound strictly by your local CPU and RAM.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
