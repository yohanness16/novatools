---
import Layout from '../layouts/Layout.astro';
import { HeroSection } from '../components/HeroSection';
import AboutSection from '../components/AboutSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import { ShieldCheck } from 'lucide-react';
---

<Layout
  title="NovaTools - 100% Private Media, Video & PDF Utilities"
  description="High-performance, privacy-first PDF, image, video, and audio tools running instantly in your browser. Zero cloud uploads, 100% free."
>
  {/* Dynamic Interactive Hero Section */}
  <HeroSection client:load />

  {/* Alternating Zig-Zag About Us Section */}
  <AboutSection />

  {/* Interactive Bento Grid Services Section */}
  <ServicesSection />

  <div id="catalog" class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 space-y-12">
    {/* Architecture & Security Ledger */}
    <section class="rounded-xl border border-slate-200 dark:border-white/10 bg-white/80 dark:bg-[#0A0F1D]/80 backdrop-blur-md p-6 sm:p-7 space-y-4 shadow-xl">
      <div class="flex items-center gap-2.5 border-b border-slate-200 dark:border-white/10 pb-3 text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">
        <ShieldCheck class="h-4 w-4 text-sky-600 dark:text-[#38BDF8]" />
        <span>Privacy & Performance Guarantee</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="rounded-lg bg-slate-100 dark:bg-[#0D1426] p-4 border border-slate-200 dark:border-white/10 space-y-1.5">
          <div class="font-bold text-slate-900 dark:text-white">Zero Server Uploads</div>
          <p class="text-slate-600 dark:text-[#94A3B8] leading-relaxed">
            All document decryption, image rendering, and video slicing execute completely inside your private browser memory.
          </p>
        </div>

        <div class="rounded-lg bg-slate-100 dark:bg-[#0D1426] p-4 border border-slate-200 dark:border-white/10 space-y-1.5">
          <div class="font-bold text-slate-900 dark:text-white">Instant Processing</div>
          <p class="text-slate-600 dark:text-[#94A3B8] leading-relaxed">
            Local device execution eliminates bandwidth lag, upload delays, and cloud conversion waiting lines.
          </p>
        </div>

        <div class="rounded-lg bg-slate-100 dark:bg-[#0D1426] p-4 border border-slate-200 dark:border-white/10 space-y-1.5">
          <div class="font-bold text-slate-900 dark:text-white">No Limits or Quotas</div>
          <p class="text-slate-600 dark:text-[#94A3B8] leading-relaxed">
            Convert, compress, and edit as many files as you need without daily limits, file restrictions, or paywalls.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
