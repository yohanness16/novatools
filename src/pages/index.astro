---
import Layout from '../layouts/Layout.astro';
import { HeroSection } from '../components/HeroSection';
import AboutSection from '../components/AboutSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import { ShieldCheck, Lock, Code, Eye } from 'lucide-react';
---

<Layout
  title="NovaTools - 100% Private In-Browser Media, Video & PDF Utilities"
  description="High-performance, privacy-first PDF, image, video, and audio tools running instantly in your browser. Zero cloud uploads, 100% free."
>
  {/* Dynamic Interactive Hero Section (100vh) */}
  <HeroSection client:load />

  {/* Alternating Architecture & Speed About Section */}
  <AboutSection />

  {/* Interactive Bento Grid Services Section */}
  <ServicesSection />

  {/* Security Ledger & Open Architecture Guarantee */}
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <section class="rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#1e2025] p-6 sm:p-8 space-y-6 shadow-sm">
      <div class="flex items-center gap-2.5 border-b border-slate-200 dark:border-white/[0.06] pb-4 text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white font-mono">
        <ShieldCheck class="h-4 w-4 text-emerald-600 dark:text-emerald-400" />
        <span>SECURITY_LEDGER // ARCHITECTURE GUARANTEE</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
            <Lock class="h-4 w-4 text-blue-600 dark:text-blue-400" />
            <span>Stateless by Default</span>
          </div>
          <p class="text-slate-600 dark:text-[#9ca3af] leading-relaxed">
            We maintain zero databases of user files. The application runs entirely from static assets loaded into your local browser cache.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
            <Code class="h-4 w-4 text-blue-600 dark:text-blue-400" />
            <span>100% Client-Side Runtime</span>
          </div>
          <p class="text-slate-600 dark:text-[#9ca3af] leading-relaxed">
            All algorithms, from PDF manipulation to AI neural inference, execute directly on your local device CPU and GPU.
          </p>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2 text-sm font-bold text-slate-900 dark:text-white">
            <Eye class="h-4 w-4 text-blue-600 dark:text-blue-400" />
            <span>Open Verification</span>
          </div>
          <p class="text-slate-600 dark:text-[#9ca3af] leading-relaxed">
            Inspect network activity via Browser DevTools at any time to verify zero outbound requests transmitting payload data.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
