---
import Layout from '../layouts/Layout.astro';
import { HeroSection } from '../components/HeroSection';
import { TOOLS, CATEGORIES } from '../lib/toolsData';
import {
  Layers, Scissors, RotateCw, Lock, EyeOff, FileImage, FilePlus,
  Repeat, Minimize2, Maximize2, ShieldCheck, Code, Film, Clock, Music, VolumeX, Volume2, Subtitles,
  Shield, Cpu, HardDrive, Terminal, Search, ArrowRight, FileText, Image as ImageIcon, Video, Sparkles
} from 'lucide-react';

const iconMap: Record<string, any> = {
  Layers, Scissors, RotateCw, Lock, EyeOff, FileImage, FilePlus,
  Repeat, Minimize2, Maximize2, ShieldCheck, Code, Film, Clock, Music, VolumeX, Volume2, Subtitles,
  FileText
};

const categoryIcons: Record<string, any> = {
  all: Sparkles,
  pdf: FileText,
  image: ImageIcon,
  video: Video,
  svg: Code,
};
---

<Layout
  title="NovaTools - 100% Private Media, Video & PDF Utilities"
  description="High-performance, privacy-first PDF, image, video, and audio tools running instantly in your browser. Zero cloud uploads, 100% free."
>
  {/* Dynamic Interactive Hero Section */}
  <HeroSection client:load />

  <div id="catalog" class="w-full px-4 sm:px-6 lg:px-10 pb-16 space-y-12">
    {/* Suite Filter Bar */}
    <div class="rounded-xl border border-white/10 bg-[#0A0F1D]/80 backdrop-blur-md p-4 sm:p-5 shadow-xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">
            Tool Directory
          </h2>
          <p class="text-xs text-[#94A3B8]">
            Browse all 21+ private media and document tools ready for instant use.
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          {CATEGORIES.map((cat) => {
            const CatIcon = categoryIcons[cat.id] || FileText;
            return (
              <a
                href={cat.id === 'all' ? '#catalog' : `/#${cat.id}-suite`}
                class={`flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium border transition-all ${
                  cat.id === 'all'
                    ? 'bg-[#0C2340] text-[#38BDF8] border-[#38BDF8]/40 shadow-sm'
                    : 'bg-[#0D1426] text-[#94A3B8] border-white/10 hover:text-white hover:border-[#38BDF8]/40'
                }`}
              >
                <CatIcon class="h-3.5 w-3.5" />
                <span>{cat.label}</span>
                <span class="font-mono text-[10px] text-[#64748B]">({cat.count})</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

    {/* Tool Suite Sections */}
    {CATEGORIES.filter(c => c.id !== 'all').map((cat) => {
      const suiteTools = TOOLS.filter(t => t.category === cat.id);
      const CatIcon = categoryIcons[cat.id] || FileText;

      return (
        <section id={`${cat.id}-suite`} class="space-y-4 pt-2">
          {/* Section Header */}
          <div class="flex items-center justify-between border-b border-white/10 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-[#0D1426] border border-white/10 text-[#38BDF8]">
                <CatIcon class="h-4 w-4" />
              </div>
              <h2 class="text-sm sm:text-base font-bold uppercase tracking-wider text-white">
                {cat.label}
              </h2>
              <span class="font-mono text-xs text-[#64748B]">
                ({suiteTools.length} tools)
              </span>
            </div>

            <span className="hidden sm:inline-flex items-center gap-1.5 font-mono text-[11px] text-[#34D399] bg-[#34D399]/10 px-2.5 py-0.5 rounded-full border border-[#34D399]/20">
              <span className="h-1.5 w-1.5 rounded-full bg-[#34D399]" />
              Zero Uploads
            </span>
          </div>

          {/* Tools Grid */}
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3.5">
            {suiteTools.map((tool) => {
              const Icon = iconMap[tool.iconName] || FileText;

              return (
                <a
                  href={tool.path}
                  class="group flex flex-col justify-between rounded-xl border border-white/10 bg-[#0A0F1D]/90 p-4 transition-all hover:border-[#38BDF8]/60 hover:bg-[#0D1426] hover:shadow-lg hover:shadow-cyan-950/20"
                >
                  <div class="space-y-3">
                    <div class="flex items-center justify-between">
                      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#0D1426] border border-white/10 text-[#94A3B8] group-hover:text-[#38BDF8] group-hover:border-[#38BDF8]/40 transition-colors">
                        <Icon class="h-4 w-4" />
                      </div>

                      {tool.badge && (
                        <span class="font-mono text-[10px] font-medium text-[#38BDF8] bg-[#0C2340] px-2 py-0.5 rounded border border-[#38BDF8]/30">
                          {tool.badge}
                        </span>
                      )}
                    </div>

                    <div class="space-y-1">
                      <h3 class="text-sm font-semibold text-white group-hover:text-[#38BDF8] transition-colors">
                        {tool.name}
                      </h3>
                      <p class="text-xs text-[#94A3B8] line-clamp-2 leading-relaxed">
                        {tool.description}
                      </p>
                    </div>
                  </div>

                  <div class="flex items-center justify-between pt-4 mt-3 border-t border-white/[0.06] font-mono text-[10px] text-[#64748B]">
                    <span class="text-[#34D399]">100% Private</span>
                    <span class="flex items-center gap-1 text-[#94A3B8] group-hover:text-[#38BDF8] transition-colors">
                      Open Tool <ArrowRight class="h-3 w-3" />
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      );
    })}

    {/* Architecture & Security Ledger */}
    <section class="rounded-xl border border-white/10 bg-[#0A0F1D]/80 backdrop-blur-md p-6 sm:p-7 space-y-4 shadow-xl">
      <div class="flex items-center gap-2.5 border-b border-white/10 pb-3 text-xs font-semibold uppercase tracking-wider text-white">
        <ShieldCheck class="h-4 w-4 text-[#38BDF8]" />
        <span>Privacy & Performance Guarantee</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="rounded-lg bg-[#0D1426] p-4 border border-white/10 space-y-1.5">
          <div class="font-semibold text-white">Zero Server Uploads</div>
          <p class="text-[#94A3B8] leading-relaxed">
            All document decryption, image rendering, and video slicing execute completely inside your private browser memory.
          </p>
        </div>

        <div class="rounded-lg bg-[#0D1426] p-4 border border-white/10 space-y-1.5">
          <div class="font-semibold text-white">Instant Processing</div>
          <p class="text-[#94A3B8] leading-relaxed">
            Local device execution eliminates bandwidth lag, upload delays, and cloud conversion waiting lines.
          </p>
        </div>

        <div class="rounded-lg bg-[#0D1426] p-4 border border-white/10 space-y-1.5">
          <div class="font-semibold text-white">No Limits or Quotas</div>
          <p class="text-[#94A3B8] leading-relaxed">
            Convert, compress, and edit as many files as you need without daily limits, file restrictions, or paywalls.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>
