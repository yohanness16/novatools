---
import { Layers, Image as ImageIcon, Video, FileText, Code2, ArrowRight, ShieldCheck, Volume2, Wand2 } from 'lucide-react';
---

<section id="services" class="w-full py-16 sm:py-24 relative overflow-hidden border-t border-slate-200 dark:border-white/[0.08] bg-slate-50/50 dark:bg-[#121316]">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    {/* Section Header */}
    <div class="text-center max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#1e2025] text-xs font-mono text-slate-700 dark:text-[#d1d5db]">
        <span>TOOL_SUITE_CATALOG</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
        Comprehensive Utility Grid
      </h2>
      <p class="text-sm text-slate-600 dark:text-[#9ca3af] leading-relaxed">
        Six specialized engines engineered for precision client-side execution with zero cloud dependencies.
      </p>
    </div>

    {/* Bento Grid Container */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5">
      
      {/* BENTO CARD 1: PDF Manipulation (Large - Col Span 7) */}
      <a
        href="/pdf"
        class="group relative md:col-span-2 lg:col-span-7 rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#1e2025] p-6 flex flex-col justify-between overflow-hidden transition-all duration-200 hover:border-blue-500/50 hover:shadow-lg"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/40">
              <Layers class="h-4 w-4" />
            </div>
            <span class="font-mono text-[11px] text-slate-500 dark:text-[#9ca3af]">ENGINE_01</span>
          </div>

          <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight pt-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            PDF Manipulation & Fusion
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-[#9ca3af] leading-relaxed max-w-md">
            Merge multi-page documents, split chapters, protect with AES password encryption, redact annotations, and re-order pages instantly.
          </p>
        </div>

        {/* UI Preview Area */}
        <div class="mt-6 pt-4 border-t border-slate-100 dark:border-white/[0.04] space-y-3">
          <div class="flex items-center justify-center gap-3 py-3">
            <div class="h-16 w-14 rounded bg-slate-100 dark:bg-[#16171a] border border-slate-200 dark:border-white/[0.08] p-2 -rotate-6 shadow-sm flex flex-col justify-between">
              <span class="font-mono text-[8px] text-slate-400">01</span>
              <div class="h-1 w-full bg-slate-300 dark:bg-slate-700 rounded"></div>
            </div>
            <div class="h-20 w-16 rounded bg-blue-50 dark:bg-[#1a2333] border-2 border-blue-500 p-2.5 z-10 shadow-md flex flex-col justify-between scale-105">
              <span class="font-mono text-[8px] font-bold text-blue-600 dark:text-blue-400">MERGE</span>
              <div class="space-y-1">
                <div class="h-1 w-full bg-blue-400/50 rounded"></div>
                <div class="h-1 w-2/3 bg-blue-400/50 rounded"></div>
              </div>
            </div>
            <div class="h-16 w-14 rounded bg-slate-100 dark:bg-[#16171a] border border-slate-200 dark:border-white/[0.08] p-2 rotate-6 shadow-sm flex flex-col justify-between">
              <span class="font-mono text-[8px] text-slate-400">02</span>
              <div class="h-1 w-full bg-slate-300 dark:bg-slate-700 rounded"></div>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-[#9ca3af]">
            <span>10 Tools Available</span>
            <span class="flex items-center gap-1 text-blue-600 dark:text-blue-400 font-semibold group-hover:underline">
              Launch Suite <ArrowRight class="h-3 w-3" />
            </span>
          </div>
        </div>
      </a>

      {/* BENTO CARD 2: AI Background Removal (Col Span 5) */}
      <a
        href="/image"
        class="group relative md:col-span-2 lg:col-span-5 rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#1e2025] p-6 flex flex-col justify-between overflow-hidden transition-all duration-200 hover:border-blue-500/50 hover:shadow-lg"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/40">
              <ImageIcon class="h-4 w-4" />
            </div>
            <span class="font-mono text-[11px] text-slate-500 dark:text-[#9ca3af]">ENGINE_02</span>
          </div>

          <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight pt-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            Image Studio & Cutout
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-[#9ca3af] leading-relaxed">
            AI neural background removal, format converter (AVIF, WebP, PNG), lossless compression, and EXIF metadata sanitizer.
          </p>
        </div>

        {/* UI Preview Area */}
        <div class="mt-6 pt-4 border-t border-slate-100 dark:border-white/[0.04] space-y-3">
          <div class="h-20 w-full rounded-lg border border-slate-200 dark:border-white/[0.08] bg-checkerboard flex items-center justify-center relative overflow-hidden">
            <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white dark:bg-[#16171a] border border-slate-200 dark:border-white/[0.08] shadow-sm text-xs font-mono text-slate-800 dark:text-white">
              <Wand2 class="h-3.5 w-3.5 text-emerald-500" />
              <span>ALPHA_MASK_EXTRACT</span>
            </div>
          </div>

          <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-[#9ca3af]">
            <span>6 Tools Available</span>
            <span class="flex items-center gap-1 text-blue-600 dark:text-blue-400 font-semibold group-hover:underline">
              Launch Suite <ArrowRight class="h-3 w-3" />
            </span>
          </div>
        </div>
      </a>

      {/* BENTO CARD 3: Video Suite (Col Span 4) */}
      <a
        href="/video"
        class="group relative lg:col-span-4 rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#1e2025] p-5 flex flex-col justify-between overflow-hidden transition-all duration-200 hover:border-blue-500/50 hover:shadow-lg"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 dark:bg-blue-950/40 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/40">
              <Video class="h-4 w-4" />
            </div>
            <span class="font-mono text-[10px] text-slate-500 dark:text-[#9ca3af]">ENGINE_03</span>
          </div>

          <h3 class="text-base font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            Video & Subtitle Suite
          </h3>
          <p class="text-xs text-slate-600 dark:text-[#9ca3af] leading-relaxed">
            Trim footage, generate speech-to-text subtitles, mute audio, and convert to GIF.
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/[0.04] flex items-center justify-between text-xs font-mono text-slate-500 dark:text-[#9ca3af]">
          <span>8 Video Tools</span>
          <span class="text-blue-600 dark:text-blue-400 flex items-center gap-1 font-semibold group-hover:underline">
            Open <ArrowRight class="h-2.5 w-2.5" />
          </span>
        </div>
      </a>

      {/* BENTO CARD 4: Document & AI Studio (Col Span 4) */}
      <a
        href="/document"
        class="group relative lg:col-span-4 rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#1e2025] p-5 flex flex-col justify-between overflow-hidden transition-all duration-200 hover:border-blue-500/50 hover:shadow-lg"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-400 border border-indigo-200 dark:border-indigo-800/40">
              <FileText class="h-4 w-4" />
            </div>
            <span class="font-mono text-[10px] text-slate-500 dark:text-[#9ca3af]">ENGINE_04</span>
          </div>

          <h3 class="text-base font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            Document & AI Studio
          </h3>
          <p class="text-xs text-slate-600 dark:text-[#9ca3af] leading-relaxed">
            Universal Document Studio, Markdown to DOCX/PDF, OpenXML parsing, and slide deck generation.
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/[0.04] flex items-center justify-between text-xs font-mono text-slate-500 dark:text-[#9ca3af]">
          <span>7 Doc Tools</span>
          <span class="text-blue-600 dark:text-blue-400 flex items-center gap-1 font-semibold group-hover:underline">
            Open <ArrowRight class="h-2.5 w-2.5" />
          </span>
        </div>
      </a>

      {/* BENTO CARD 5: SVG & Diagrams (Col Span 4) */}
      <a
        href="/svg"
        class="group relative lg:col-span-4 rounded-xl border border-slate-200 dark:border-white/[0.08] bg-white dark:bg-[#1e2025] p-5 flex flex-col justify-between overflow-hidden transition-all duration-200 hover:border-blue-500/50 hover:shadow-lg"
      >
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800/40">
              <Code2 class="h-4 w-4" />
            </div>
            <span class="font-mono text-[10px] text-slate-500 dark:text-[#9ca3af]">ENGINE_05</span>
          </div>

          <h3 class="text-base font-bold text-slate-900 dark:text-white tracking-tight group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            SVG & Vector Tools
          </h3>
          <p class="text-xs text-slate-600 dark:text-[#9ca3af] leading-relaxed">
            Minify SVG markup, strip editor comments, precision scaling, and architecture diagramming.
          </p>
        </div>

        <div class="mt-4 pt-3 border-t border-slate-100 dark:border-white/[0.04] flex items-center justify-between text-xs font-mono text-slate-500 dark:text-[#9ca3af]">
          <span>5 Vector Tools</span>
          <span class="text-blue-600 dark:text-blue-400 flex items-center gap-1 font-semibold group-hover:underline">
            Open <ArrowRight class="h-2.5 w-2.5" />
          </span>
        </div>
      </a>

    </div>

  </div>
</section>
