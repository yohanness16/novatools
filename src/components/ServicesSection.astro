---
---

<section id="services" class="w-full py-16 sm:py-24 relative overflow-hidden">
  {/* Ambient Sci-Fi Glow Mesh */}
  <div class="pointer-events-none absolute top-1/4 right-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl -z-10" />
  <div class="pointer-events-none absolute bottom-10 left-1/4 w-96 h-96 bg-cyan-600/10 rounded-full blur-3xl -z-10" />

  <div class="w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
    
    {/* Section Header: Bold and Clean */}
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white">
        Services
      </h2>
    </div>

    {/* Bento Grid Container */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-5">
      
      {/* BENTO CARD 1: PDF Suite (Large Hero Card - Col Span 7) */}
      <div class="group relative md:col-span-2 lg:col-span-7 rounded-2xl border border-white/10 bg-[#0A0F1D]/80 backdrop-blur-xl p-6 sm:p-7 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-cyan-500/40 hover:shadow-2xl hover:shadow-cyan-950/30">
        
        {/* Card Copy */}
        <div class="space-y-2 z-10">
          <div class="font-mono text-xs font-semibold uppercase tracking-wider text-cyan-400">
            Document Suite
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            PDF Manipulation & Fusion
          </h3>
          <p class="text-xs sm:text-sm text-[#94A3B8] max-w-md leading-relaxed">
            Merge multi-page documents, split chapters, encrypt files, redact private text, and reorder pages locally in memory.
          </p>
        </div>

        {/* UI Interactive Preview Widget: Dynamic Document Fan & Progress */}
        <div class="mt-6 pt-4 border-t border-white/5 relative flex flex-col gap-3">
          
          {/* Document Pages Fanning UI */}
          <div class="flex items-center justify-center gap-2.5 py-4">
            <div class="h-20 w-16 rounded-lg bg-slate-900/90 border border-white/15 p-2 shadow-lg -rotate-6 transition-transform duration-300 group-hover:-rotate-12 group-hover:-translate-x-1 flex flex-col justify-between">
              <span class="font-mono text-[9px] font-bold text-slate-400">P.01</span>
              <div class="space-y-1">
                <div class="h-1 w-full bg-slate-700 rounded" />
                <div class="h-1 w-3/4 bg-slate-700 rounded" />
              </div>
            </div>

            <div class="h-22 w-18 rounded-lg bg-[#0C192E] border border-cyan-500/40 p-2.5 shadow-xl z-10 flex flex-col justify-between scale-105 transition-transform duration-300 group-hover:scale-110">
              <span class="font-mono text-[9px] font-bold text-cyan-300">P.02</span>
              <div class="space-y-1">
                <div class="h-1 w-full bg-cyan-400/40 rounded" />
                <div class="h-1 w-4/5 bg-cyan-400/40 rounded" />
                <div class="h-1 w-2/3 bg-cyan-400/30 rounded" />
              </div>
            </div>

            <div class="h-20 w-16 rounded-lg bg-slate-900/90 border border-white/15 p-2 shadow-lg rotate-6 transition-transform duration-300 group-hover:rotate-12 group-hover:translate-x-1 flex flex-col justify-between">
              <span class="font-mono text-[9px] font-bold text-slate-400">P.03</span>
              <div class="space-y-1">
                <div class="h-1 w-full bg-slate-700 rounded" />
                <div class="h-1 w-3/4 bg-slate-700 rounded" />
              </div>
            </div>
          </div>

          {/* Engine Status Bar */}
          <div class="flex items-center justify-between px-3.5 py-2 rounded-lg bg-[#050811]/90 border border-white/5 font-mono text-[11px]">
            <span class="text-slate-300 font-medium">Merged_Document.pdf</span>
            <span class="text-[#34D399] font-semibold">Ready · Instant</span>
          </div>

        </div>

      </div>


      {/* BENTO CARD 2: AI Image Cutout Studio (Col Span 5) */}
      <div class="group relative md:col-span-2 lg:col-span-5 rounded-2xl border border-white/10 bg-[#0A0F1D]/80 backdrop-blur-xl p-6 sm:p-7 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-teal-500/40 hover:shadow-2xl hover:shadow-teal-950/30">
        
        {/* Card Copy */}
        <div class="space-y-2 z-10">
          <div class="font-mono text-xs font-semibold uppercase tracking-wider text-teal-400">
            Image Studio
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Background Removal & Processing
          </h3>
          <p class="text-xs sm:text-sm text-[#94A3B8] leading-relaxed">
            AI edge detection, lossless compression, EXIF scrubbing, and format conversion.
          </p>
        </div>

        {/* UI Interactive Preview Widget: Scanner & Split Alpha */}
        <div class="mt-6 pt-4 border-t border-white/5">
          <div class="relative h-28 w-full rounded-xl border border-teal-500/30 overflow-hidden bg-checkerboard flex items-center justify-center shadow-inner">
            
            {/* Cutout Graphic Shape with Scanning Pulse */}
            <div class="relative w-36 h-20 rounded-lg bg-gradient-to-r from-teal-500/20 via-cyan-500/30 to-emerald-500/20 border border-teal-400/50 flex items-center justify-center">
              <div class="font-mono text-xs font-bold text-teal-200 tracking-wider">
                ALPHA MASK
              </div>
              
              {/* Vertical Laser Scanner Animation */}
              <div class="absolute inset-y-0 w-1 bg-gradient-to-b from-transparent via-teal-300 to-transparent shadow-[0_0_12px_rgba(45,212,191,0.9)] animate-pulse" />
            </div>

            {/* Micro Badge */}
            <div class="absolute bottom-2 right-2 px-2 py-0.5 rounded bg-slate-950/80 border border-teal-500/30 font-mono text-[10px] text-teal-300">
              0.04s Local
            </div>
          </div>
        </div>

      </div>


      {/* BENTO CARD 3: Audio & Voice Engine (Col Span 4) */}
      <div class="group relative lg:col-span-4 rounded-2xl border border-white/10 bg-[#0A0F1D]/80 backdrop-blur-xl p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-purple-500/40 hover:shadow-2xl hover:shadow-purple-950/30">
        
        {/* Card Copy */}
        <div class="space-y-2 z-10">
          <div class="font-mono text-xs font-semibold uppercase tracking-wider text-purple-400">
            Audio Engine
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight">
            Soundtrack & Volume Boost
          </h3>
          <p class="text-xs text-[#94A3B8] leading-relaxed">
            Extract pure MP3 audio from videos, amplify quiet audio up to +20dB, and generate subtitle SRT files.
          </p>
        </div>

        {/* UI Interactive Preview Widget: Audio Equalizer Bars */}
        <div class="mt-6 pt-4 border-t border-white/5 space-y-3">
          <div class="h-16 w-full rounded-xl bg-[#050811]/90 border border-white/5 p-3 flex items-end justify-between gap-1">
            {[35, 70, 45, 90, 60, 100, 75, 40, 85, 55, 95, 65, 30, 80, 50, 90].map((height, i) => (
              <div
                key={i}
                class="w-full rounded-t-sm bg-gradient-to-t from-purple-600 via-indigo-400 to-cyan-300 transition-all duration-300 group-hover:brightness-125"
                style={`height: ${height}%;`}
              />
            ))}
          </div>

          <div class="flex items-center justify-between font-mono text-[10px] text-purple-300 px-1">
            <span>+12 dB Gain Active</span>
            <span>48.0 kHz Lossless</span>
          </div>
        </div>

      </div>


      {/* BENTO CARD 4: Video Precision Suite (Col Span 4) */}
      <div class="group relative lg:col-span-4 rounded-2xl border border-white/10 bg-[#0A0F1D]/80 backdrop-blur-xl p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-blue-500/40 hover:shadow-2xl hover:shadow-blue-950/30">
        
        {/* Card Copy */}
        <div class="space-y-2 z-10">
          <div class="font-mono text-xs font-semibold uppercase tracking-wider text-blue-400">
            Video Suite
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight">
            Trimming & Transcoding
          </h3>
          <p class="text-xs text-[#94A3B8] leading-relaxed">
            Trim footage with millisecond precision, mute unwanted audio channels, convert video to GIF, and compress file size.
          </p>
        </div>

        {/* UI Interactive Preview Widget: Video Timeline Scrubber */}
        <div class="mt-6 pt-4 border-t border-white/5 space-y-2.5">
          <div class="h-16 w-full rounded-xl bg-[#050811]/90 border border-white/5 p-2.5 flex flex-col justify-between">
            <div class="flex items-center justify-between font-mono text-[10px] text-slate-400">
              <span class="text-blue-300">00:03.20</span>
              <span>00:15.00</span>
            </div>

            {/* Scrubber Bar */}
            <div class="relative w-full h-3 bg-slate-900 rounded overflow-hidden">
              <div class="absolute left-1/4 right-1/3 inset-y-0 bg-blue-500/30 border-x-2 border-blue-400" />
              <div class="absolute left-1/3 top-0 bottom-0 w-0.5 bg-white shadow-[0_0_8px_white]" />
            </div>

            <div class="flex items-center justify-between font-mono text-[9px] text-slate-500">
              <span>TRIM START</span>
              <span>TRIM END</span>
            </div>
          </div>

          <div class="font-mono text-[10px] text-blue-300 text-right px-1">
            WebCodecs Accelerated
          </div>
        </div>

      </div>


      {/* BENTO CARD 5: Privacy & Code Optimizer (Col Span 4) */}
      <div class="group relative lg:col-span-4 rounded-2xl border border-white/10 bg-[#0A0F1D]/80 backdrop-blur-xl p-6 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-emerald-500/40 hover:shadow-2xl hover:shadow-emerald-950/30">
        
        {/* Card Copy */}
        <div class="space-y-2 z-10">
          <div class="font-mono text-xs font-semibold uppercase tracking-wider text-emerald-400">
            Privacy & Code
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight">
            SVG Clean & Metadata Purge
          </h3>
          <p class="text-xs text-[#94A3B8] leading-relaxed">
            Scrub sensitive camera EXIF and GPS tags from photos and minify vector SVG markup for high-speed web delivery.
          </p>
        </div>

        {/* UI Interactive Preview Widget: Live Metric Counter */}
        <div class="mt-6 pt-4 border-t border-white/5 space-y-2.5">
          <div class="rounded-xl bg-[#050811]/90 border border-white/5 p-3 space-y-2 font-mono text-xs">
            <div class="flex items-center justify-between text-slate-300">
              <span>GPS Coordinates</span>
              <span class="text-emerald-400 font-bold">REMOVED</span>
            </div>
            <div class="flex items-center justify-between text-slate-300">
              <span>Camera Model & Serial</span>
              <span class="text-emerald-400 font-bold">PURGED</span>
            </div>
            <div class="flex items-center justify-between text-slate-300">
              <span>Vector Markup Size</span>
              <span class="text-emerald-400 font-bold">-64.2%</span>
            </div>
          </div>

          <div class="font-mono text-[10px] text-emerald-300 text-right px-1">
            Zero File Footprint
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
