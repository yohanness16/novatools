---
import Layout from '../layouts/Layout.astro';
import { TOOLS, SUITES, type ToolMeta } from '../lib/toolsData';
import {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
  ArrowRight,
  Image as ImageIcon,
  Video,
  Network,
} from 'lucide-react';

interface Props {
  category: ToolMeta['category'];
  title: string;
  description: string;
  headingHighlight?: string;
}

const { category, title, description } = Astro.props;

const iconMap: Record<string, any> = {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
  ImageIcon,
  Video,
  Network,
};

const suite = SUITES.find((s) => s.id === category)!;
const suiteTools = TOOLS.filter((t) => t.category === category);
---

<Layout title={title} description={description}>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6">
    {/* Compact Visual Suite Header */}
    <div class="nt-window p-4 sm:p-5 flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <div class="h-14 w-14 sm:h-16 sm:w-16 rounded-xl overflow-hidden border border-[var(--nt-border)] bg-[#F8FAFC] dark:bg-[#181B22] shrink-0">
          <img src={suite.image} alt={suite.label} class="h-full w-full object-cover" />
        </div>
        <div class="flex items-baseline gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[#111214] dark:text-[#F3F4F6]">
            {suite.label}
          </h1>
          <span class="font-mono text-xs text-[#6B7280] dark:text-[#9CA3AF]">
            {suiteTools.length}
          </span>
        </div>
      </div>

      <a
        href="/"
        class="nt-btn-secondary px-3 py-1.5 text-xs font-semibold shrink-0"
      >
        All
      </a>
    </div>

    {/* Action Grid */}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      {suiteTools.map((tool) => {
        const Icon = iconMap[tool.iconName] || Layers;

        return (
          <a
            href={tool.path}
            class="group nt-card-interactive p-4 flex flex-col justify-between gap-4 min-h-[104px]"
          >
            <div class="flex items-center justify-between">
              <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-[#EFF6FF] dark:bg-[#3B82F6]/15 text-[#2563EB] dark:text-[#60A5FA] transition-colors group-hover:bg-[#2563EB] group-hover:text-white">
                <Icon class="h-4 w-4" />
              </div>
              <ArrowRight class="h-3.5 w-3.5 text-[#9CA3AF] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 group-hover:text-[#2563EB] transition-all" />
            </div>

            <span class="text-sm font-bold text-[#111214] dark:text-[#F3F4F6] truncate">
              {tool.shortName}
            </span>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
