---
import Layout from '../layouts/Layout.astro';
import { TOOLS, type ToolMeta } from '../lib/toolsData';
import AdSenseAd from './AdSenseAd.astro';
import {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
  ArrowRight,
  Image as ImageIcon,
  Video,
  Network,
} from 'lucide-react';

interface Props {
  category: ToolMeta['category'];
  title: string;
  description: string;
  suiteCode: string;
  headingPrefix: string;
  headingHighlight: string;
  summary: string;
  sectionTitle: string;
}

const {
  category,
  title,
  description,
  suiteCode,
  headingPrefix,
  headingHighlight,
  summary,
  sectionTitle,
} = Astro.props;

const iconMap: Record<string, any> = {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
  ImageIcon,
  Video,
  Network,
};

const categoryHeaderIcon: Record<ToolMeta['category'], any> = {
  pdf: FileText,
  image: ImageIcon,
  video: Video,
  document: FileText,
  diagram: Network,
  svg: Code,
};

const suiteTools = TOOLS.filter((t) => t.category === category);
const HeaderIcon = categoryHeaderIcon[category] || Layers;
---

<Layout title={title} description={description}>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-10">
    {/* Suite Desktop Header Card */}
    <div class="nt-window overflow-hidden">
      <div class="flex items-center justify-between px-5 py-3 border-b border-[var(--nt-border)] bg-[#FCFBF8] dark:bg-[#191714]">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-3 w-3 rounded-full bg-[#141413] dark:bg-[#FAF7F0]/35"></span>
            <span class="h-3 w-3 rounded-full bg-[#FACC15]"></span>
            <span class="h-3 w-3 rounded-full bg-[#D6CFC0] dark:bg-[#454038]"></span>
          </div>
          <div class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-[#141413] dark:text-[#FAF7F0]">
            <HeaderIcon class="h-3.5 w-3.5 text-[#CA8A04] dark:text-[#FACC15]" />
            <span>{suiteCode} // {suiteTools.length} TOOLS</span>
          </div>
        </div>
        <span class="nt-badge-success px-2.5 py-0.5 font-mono text-[10px] font-bold">
          Local Processing
        </span>
      </div>

      <div class="p-6 sm:p-8 space-y-4">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#141413] dark:text-[#FAF7F0] leading-tight">
          {headingPrefix}{' '}
          <span class="inline-block px-2.5 py-0.5 rounded-xl bg-[#FACC15] text-[#141413] shadow-[0_3px_0_#C99A00]">
            {headingHighlight}
          </span>
        </h1>
        <p class="text-sm sm:text-base text-[#454038] dark:text-[#CBC4B6] max-w-2xl leading-relaxed">
          {summary}
        </p>
      </div>
    </div>

    {/* Tools Grid */}
    <div class="space-y-4">
      <div class="flex items-center justify-between border-b border-[var(--nt-border)] pb-3">
        <h2 class="text-lg font-extrabold tracking-tight text-[#141413] dark:text-[#FAF7F0]">
          {sectionTitle}
        </h2>
        <span class="text-xs text-[#746D61] dark:text-[#938B7D] font-mono font-semibold">
          {suiteTools.length} {suiteTools.length === 1 ? 'tool' : 'tools'} available
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {suiteTools.map((tool) => {
          const Icon = iconMap[tool.iconName] || HeaderIcon;

          return (
            <a
              href={tool.path}
              class="group nt-card-interactive flex flex-col justify-between p-5"
            >
              <div class="space-y-3.5">
                <div class="flex items-center justify-between">
                  <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#141413] text-[#FACC15] shadow-sm transition-transform duration-150 group-hover:-translate-y-0.5">
                    <Icon class="h-4 w-4" />
                  </div>

                  {tool.badge && (
                    <span class="nt-badge-yellow font-mono text-[10px] font-bold px-2.5 py-0.5">
                      {tool.badge}
                    </span>
                  )}
                </div>

                <div class="space-y-1.5">
                  <h3 class="text-base font-extrabold text-[#141413] dark:text-[#FAF7F0] group-hover:underline">
                    {tool.name}
                  </h3>
                  <p class="text-xs text-[#454038] dark:text-[#CBC4B6] line-clamp-2 leading-relaxed">
                    {tool.description}
                  </p>
                </div>
              </div>

              <div class="flex items-center justify-between pt-4 mt-4 border-t border-[var(--nt-border)] font-mono text-[11px]">
                <span class="text-[#15803D] dark:text-[#4ADE80] font-bold">Local Sandbox</span>
                <span class="flex items-center gap-1 text-[#141413] dark:text-[#FACC15] font-bold group-hover:translate-x-0.5 transition-transform">
                  Launch <ArrowRight class="h-3 w-3" />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>

    <AdSenseAd slotId="5386318888" className="my-6" />

    <slot />
  </div>
</Layout>
