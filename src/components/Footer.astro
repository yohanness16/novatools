---
import { Shield, Zap } from 'lucide-react';
---

<footer class="mt-20 border-t border-[#2A2D33] bg-[#0B0C0F]">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-5">
      {/* Brand & Mission Statement */}
      <div class="lg:col-span-2 space-y-3">
        <div class="flex items-center gap-2">
          <div class="flex h-5 w-5 items-center justify-center rounded bg-[#4F8CFF] text-[#0B0C0F] font-mono text-[10px] font-bold">
            NT
          </div>
          <span class="font-mono text-sm font-semibold tracking-tight text-[#ECEDEF]">NovaTools Console</span>
        </div>
        <p class="text-xs leading-relaxed text-[#8B8F98] max-w-sm">
          High-performance client-side media and document workbench. 
          All computations, neural speech transcription, video demuxing, and PDF vector processing execute locally via WebAssembly. 
          0 bytes uploaded to remote servers.
        </p>

        <div class="flex items-center gap-4 text-xs font-mono text-[#8B8F98] pt-1">
          <div class="flex items-center gap-1.5 text-[#3FBE73]">
            <Shield class="h-3.5 w-3.5" />
            <span>Zero Network I/O</span>
          </div>
          <div class="flex items-center gap-1.5 text-[#4F8CFF]">
            <Zap class="h-3.5 w-3.5" />
            <span>Local WASM Engine</span>
          </div>
        </div>
      </div>

      {/* PDF Suite */}
      <div>
        <h3 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#ECEDEF]">PDF Suite</h3>
        <ul class="mt-2.5 space-y-1.5 text-xs">
          <li><a href="/pdf/merge" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Merge PDF</a></li>
          <li><a href="/pdf/split" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Split & Extract</a></li>
          <li><a href="/pdf/rotate" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Rotate Pages</a></li>
          <li><a href="/pdf/page-numberer" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Page Numberer</a></li>
          <li><a href="/pdf/protect" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Password Protect</a></li>
          <li><a href="/pdf/redact-flatten" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Redact & Flatten</a></li>
          <li><a href="/pdf/pdf-to-images" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">PDF to Images</a></li>
          <li><a href="/pdf/images-to-pdf" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Images to PDF</a></li>
        </ul>
      </div>

      {/* Image Suite */}
      <div>
        <h3 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#ECEDEF]">Image Suite</h3>
        <ul class="mt-2.5 space-y-1.5 text-xs">
          <li><a href="/image/background-remover" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Background Remover</a></li>
          <li><a href="/image/compressor" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Visual Compressor</a></li>
          <li><a href="/image/converter" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Format Converter</a></li>
          <li><a href="/image/resizer" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Image Resizer</a></li>
          <li><a href="/image/exif-scrubber" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">EXIF Scrubber</a></li>
          <li><a href="/image/svg-optimizer" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">SVG Cleaner</a></li>
        </ul>
      </div>

      {/* Video & Audio Suite */}
      <div>
        <h3 class="font-mono text-[11px] font-semibold uppercase tracking-wider text-[#ECEDEF]">Video & Audio</h3>
        <ul class="mt-2.5 space-y-1.5 text-xs">
          <li><a href="/video/subtitle-generator" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">AI Subtitle Generator</a></li>
          <li><a href="/video/audio-booster" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Audio Volume Booster</a></li>
          <li><a href="/video/video-to-gif" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Video to GIF Maker</a></li>
          <li><a href="/video/trimmer" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Video Trimmer</a></li>
          <li><a href="/video/compressor" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Video Compressor</a></li>
          <li><a href="/video/audio-extractor" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Extract Audio Streams</a></li>
          <li><a href="/video/muter" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Video Muter</a></li>
        </ul>
      </div>
    </div>

    {/* Bottom copyright bar */}
    <div class="mt-10 border-t border-[#2A2D33] pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[#5B606D]">
      <p class="font-mono text-[11px]">© {new Date().getFullYear()} NovaTools Suite. Local-first WebAssembly client runtime.</p>
      <div class="flex items-center gap-4 font-mono text-[11px]">
        <a href="/privacy" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Privacy Ledger</a>
        <a href="/terms" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Terms</a>
        <a href="/about" class="text-[#8B8F98] hover:text-[#ECEDEF] transition-colors">Architecture</a>
      </div>
    </div>
  </div>
</footer>
