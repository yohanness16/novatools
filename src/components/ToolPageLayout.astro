---
import Layout from '../layouts/Layout.astro';
import { type ToolMeta, TOOLS, SUITES } from '../lib/toolsData';
import {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
  CheckCircle2,
  HelpCircle,
  Sparkles,
} from 'lucide-react';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const iconMap: Record<string, any> = {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
};

const suite = SUITES.find((s) => s.id === tool.category);
const relatedTools = TOOLS.filter((t) => t.category === tool.category && t.id !== tool.id).slice(0, 6);
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: suite?.label || tool.categoryLabel, url: `/${tool.category}` },
  { name: tool.name, url: tool.path },
];
---

<Layout
  title={`${tool.name} — Free Online Client-Side Tool | NovaTools`}
  description={tool.longDescription}
  canonicalUrl={`https://toolboxs.tech${tool.path}`}
  ogImage={suite?.image}
  keywords={tool.keywords}
  faqs={tool.faqs}
  howToSteps={tool.howToSteps}
  breadcrumbs={breadcrumbs}
>
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8 space-y-6">
    {/* Compact Breadcrumb & Action Title */}
    <div class="flex items-center gap-3">
      {suite && (
        <a
          href={suite.href}
          class="h-10 w-10 rounded-xl overflow-hidden border border-[var(--nt-border)] bg-[#F5F1E8] dark:bg-[#191714] shrink-0 block shadow-card"
          aria-label={suite.label}
        >
          <img src={suite.image} alt={suite.label} class="h-full w-full object-cover" />
        </a>
      )}
      <div class="space-y-0.5">
        <nav class="flex items-center gap-1.5 text-[11px] font-mono text-[#746D61] dark:text-[#938B7D]" aria-label="Breadcrumb">
          <a href="/" class="hover:text-[#141413] dark:hover:text-[#FAF7F0] transition-colors">Home</a>
          <span>/</span>
          <a href={`/${tool.category}`} class="hover:text-[#141413] dark:hover:text-[#FACC15] transition-colors">
            {suite?.label || tool.categoryLabel}
          </a>
        </nav>
        <h1 class="text-xl sm:text-2xl font-extrabold tracking-tight text-[#141413] dark:text-[#FAF7F0]">
          {tool.name}
        </h1>
      </div>
    </div>

    {/* Desktop App Workbench Window */}
    <section class="nt-window overflow-hidden">
      <div class="flex items-center justify-between px-4 sm:px-5 py-2.5 border-b border-[var(--nt-border)] bg-[#FCFBF8] dark:bg-[#191714]">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5" aria-hidden="true">
            <span class="h-2.5 w-2.5 rounded-full bg-[#141413] dark:bg-[#FAF7F0]/35"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#FACC15]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#D6CFC0] dark:bg-[#454038]"></span>
          </div>
          <span class="font-mono text-[11px] font-bold text-[#141413] dark:text-[#FAF7F0]">
            {tool.shortName}
          </span>
        </div>
        <span class="nt-badge-yellow px-2 py-0.5 font-mono text-[10px] font-bold">
          {tool.shortTag}
        </span>
      </div>

      <div class="p-4 sm:p-6">
        <slot />
      </div>
    </section>

    {/* Related Action Chips */}
    {relatedTools.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 pt-1">
        {relatedTools.map((rel) => {
          const Icon = iconMap[rel.iconName] || Layers;
          return (
            <a
              href={rel.path}
              class="nt-card-interactive inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-[#141413] dark:text-[#FAF7F0]"
            >
              <Icon className="h-3.5 w-3.5 text-[#CA8A04] dark:text-[#FACC15]" />
              <span>{rel.shortName}</span>
            </a>
          );
        })}
      </div>
    )}

    {/* Crawlable SEO Guide, Features, How-To & FAQs (Below Workbench) */}
    <section aria-label={`${tool.name} Guide and FAQ`} class="pt-4 space-y-5">
      <div class="nt-card p-5 sm:p-6 space-y-3">
        <h2 class="text-sm sm:text-base font-extrabold text-[#141413] dark:text-[#FAF7F0]">
          About {tool.name}
        </h2>
        <p class="text-xs sm:text-sm text-[#454038] dark:text-[#CBC4B6] leading-relaxed">
          {tool.longDescription}
        </p>
        {tool.about?.paragraphs?.map((para) => (
          <p class="text-xs sm:text-sm text-[#454038] dark:text-[#CBC4B6] leading-relaxed">
            {para}
          </p>
        ))}
        {tool.about?.technicalMechanism && (
          <div class="nt-well p-3.5 text-xs text-[#454038] dark:text-[#CBC4B6] leading-relaxed">
            <strong class="text-[#141413] dark:text-[#FAF7F0] font-mono">Local Engine:</strong> {tool.about.technicalMechanism}
          </div>
        )}
        {tool.about?.supportedFormats && tool.about.supportedFormats.length > 0 && (
          <div class="flex flex-wrap items-center gap-1.5 pt-1">
            <span class="text-[11px] font-mono font-bold text-[#746D61] dark:text-[#938B7D] mr-1">Supported:</span>
            {tool.about.supportedFormats.map((fmt) => (
              <span class="nt-badge-yellow px-2 py-0.5 text-[10px] font-mono font-semibold">{fmt}</span>
            ))}
          </div>
        )}
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {/* How-To Steps */}
        {tool.howToSteps.length > 0 && (
          <div class="nt-card p-5 sm:p-6 space-y-3">
            <h2 class="text-xs font-bold text-[#141413] dark:text-[#FAF7F0] uppercase tracking-wider font-mono flex items-center gap-2">
              <Sparkles class="h-3.5 w-3.5 text-[#CA8A04] dark:text-[#FACC15]" />
              <span>How to Use {tool.shortName}</span>
            </h2>
            <ol class="space-y-2.5 text-xs text-[#454038] dark:text-[#CBC4B6]">
              {tool.howToSteps.map((s) => (
                <li class="flex items-start gap-2.5">
                  <span class="h-5 w-5 rounded-md bg-[#FEF7D6] dark:bg-[#FACC15]/15 text-[#141413] dark:text-[#FACC15] font-mono font-bold text-[11px] flex items-center justify-center shrink-0">
                    {s.step}
                  </span>
                  <div>
                    <strong class="text-[#141413] dark:text-[#FAF7F0] block">{s.title}</strong>
                    <span class="leading-relaxed">{s.desc}</span>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        )}

        {/* Key Features */}
        {tool.features.length > 0 && (
          <div class="nt-card p-5 sm:p-6 space-y-3">
            <h2 class="text-xs font-bold text-[#141413] dark:text-[#FAF7F0] uppercase tracking-wider font-mono flex items-center gap-2">
              <CheckCircle2 class="h-3.5 w-3.5 text-[#16A34A]" />
              <span>Key Capabilities</span>
            </h2>
            <ul class="space-y-2 text-xs text-[#454038] dark:text-[#CBC4B6]">
              {tool.features.map((feat) => (
                <li class="flex items-start gap-2 leading-relaxed">
                  <span class="text-[#16A34A] font-bold mt-0.5">✓</span>
                  <span>{feat}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {/* Use Cases */}
      {tool.useCases && tool.useCases.length > 0 && (
        <div class="nt-card p-5 sm:p-6 space-y-3">
          <h2 class="text-xs font-bold text-[#141413] dark:text-[#FAF7F0] uppercase tracking-wider font-mono">
            Common Use Cases
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {tool.useCases.map((uc) => (
              <div class="nt-subcard p-3.5 space-y-1">
                <h3 class="text-xs font-bold text-[#141413] dark:text-[#FAF7F0]">{uc.title}</h3>
                <p class="text-[11px] text-[#454038] dark:text-[#CBC4B6] leading-relaxed">{uc.description}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* FAQs (Visible HTML matching FAQPage JSON-LD) */}
      {tool.faqs.length > 0 && (
        <div class="nt-card p-5 sm:p-6 space-y-3">
          <h2 class="text-xs font-bold text-[#141413] dark:text-[#FAF7F0] uppercase tracking-wider font-mono flex items-center gap-2">
            <HelpCircle class="h-3.5 w-3.5 text-[#CA8A04] dark:text-[#FACC15]" />
            <span>Frequently Asked Questions</span>
          </h2>
          <div class="space-y-3">
            {tool.faqs.map((faq) => (
              <div class="nt-subcard p-3.5 space-y-1">
                <h3 class="text-xs sm:text-sm font-bold text-[#141413] dark:text-[#FAF7F0]">{faq.question}</h3>
                <p class="text-xs text-[#454038] dark:text-[#CBC4B6] leading-relaxed">{faq.answer}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  </div>
</Layout>
