---
import Layout from '../layouts/Layout.astro';
import { type ToolMeta, TOOLS, SUITES } from '../lib/toolsData';
import {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
} from 'lucide-react';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const iconMap: Record<string, any> = {
  Layers,
  Scissors,
  RotateCw,
  Lock,
  EyeOff,
  FileImage,
  FilePlus,
  FileText,
  Repeat,
  Minimize2,
  Maximize2,
  ShieldCheck,
  Code,
  Film,
  Clock,
  Music,
  VolumeX,
  Subtitles,
  Volume2,
  Printer,
  Presentation,
  FileSpreadsheet,
  Workflow,
  GitBranch,
  Database,
};

const suite = SUITES.find((s) => s.id === tool.category);
const relatedTools = TOOLS.filter((t) => t.category === tool.category && t.id !== tool.id).slice(0, 6);
---

<Layout
  title={`${tool.name} | NovaTools`}
  description={tool.longDescription}
  keywords={tool.keywords}
  faqs={tool.faqs}
>
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8 space-y-5">
    {/* Minimal Action Header */}
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        {suite && (
          <a
            href={suite.href}
            class="h-10 w-10 rounded-lg overflow-hidden border border-[var(--nt-border)] bg-[#F8FAFC] dark:bg-[#181B22] shrink-0 block"
            aria-label={suite.label}
          >
            <img src={suite.image} alt={suite.label} class="h-full w-full object-cover" />
          </a>
        )}
        <div class="space-y-0.5">
          <nav class="flex items-center gap-1.5 text-[11px] font-mono text-[#6B7280] dark:text-[#9CA3AF]" aria-label="Breadcrumb">
            <a href="/" class="hover:text-[#111214] dark:hover:text-white transition-colors">Home</a>
            <span>/</span>
            <a href={`/${tool.category}`} class="hover:text-[#111214] dark:hover:text-white transition-colors">
              {suite?.label || tool.categoryLabel}
            </a>
          </nav>
          <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-[#111214] dark:text-[#F3F4F6]">
            {tool.shortName}
          </h1>
        </div>
      </div>
    </div>

    {/* Clean Tool Workspace */}
    <section class="nt-window p-4 sm:p-6">
      <slot />
    </section>

    {/* Minimal Related Action Chips */}
    {relatedTools.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 pt-1">
        {relatedTools.map((rel) => {
          const Icon = iconMap[rel.iconName] || Layers;
          return (
            <a
              href={rel.path}
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[var(--nt-border)] bg-white dark:bg-[#13151A] hover:border-[#2563EB]/40 text-xs font-semibold text-[#4B5563] dark:text-[#9CA3AF] hover:text-[#111214] dark:hover:text-white transition-colors"
            >
              <Icon className="h-3.5 w-3.5 text-[#2563EB]" />
              <span>{rel.shortName}</span>
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>
