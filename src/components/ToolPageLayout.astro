---
import Layout from '../layouts/Layout.astro';
import { AdSlot } from './AdSlot';
import { ConsoleRail } from './ConsoleRail';
import { type ToolMeta, TOOLS } from '../lib/toolsData';
import { ChevronRight, ShieldCheck, HelpCircle, Layers, ArrowRight, Terminal, BookOpen, Sparkles } from 'lucide-react';

interface Props {
  tool: ToolMeta;
}

const { tool } = Astro.props;

const relatedTools = TOOLS.filter(t => t.category === tool.category && t.id !== tool.id).slice(0, 3);
---

<Layout
  title={`${tool.name} - 100% Client-Side Tool`}
  description={tool.longDescription}
  keywords={tool.keywords}
  faqs={tool.faqs}
>
  <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-6 items-start">
      {/* Left Navigation Rail */}
      <ConsoleRail client:load currentToolId={tool.id} currentCategory={tool.category} />

      {/* Main Workbench Area */}
      <div class="flex-1 w-full space-y-6">
        {/* Breadcrumb & Console Header */}
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-200 dark:border-[#2A2D33] pb-4">
          <div class="space-y-1">
            <nav class="flex items-center gap-1.5 text-xs text-slate-500 dark:text-[#8B8F98] font-mono" aria-label="Breadcrumb">
              <a href="/" class="hover:text-slate-900 dark:hover:text-[#ECEDEF] transition-colors">Console</a>
              <span class="text-slate-400 dark:text-[#5B606D]">/</span>
              <a href={`/${tool.category}`} class="text-slate-600 dark:text-[#8B8F98] hover:text-sky-600 dark:hover:text-[#38BDF8] capitalize transition-colors">
                {tool.categoryLabel}
              </a>
              <span class="text-slate-400 dark:text-[#5B606D]">/</span>
              <span class="text-slate-900 dark:text-[#ECEDEF] font-medium">{tool.name}</span>
            </nav>
            <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-[#ECEDEF]">
              {tool.name}
            </h1>
          </div>

          {/* Privacy Ledger Strip (Signature Element) */}
          <div class="privacy-ledger-strip shrink-0 self-start sm:self-auto border border-slate-200 dark:border-[#1E293B] bg-slate-100 dark:bg-[#0D1426] text-slate-700 dark:text-[#94A3B8]">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 dark:bg-[#3FBE73]" />
            <span>0 bytes uploaded</span>
            <span class="text-slate-400 dark:text-[#5B606D]">·</span>
            <span class="text-slate-900 dark:text-[#ECEDEF]">WASM Local Engine</span>
          </div>
        </div>

        {/* Work Surface (The Workspace IS the Hero) */}
        <section class="rounded-xl border border-slate-200 dark:border-[#2A2D33] bg-white dark:bg-[#131418] p-4 sm:p-6 shadow-sm">
          <slot />
        </section>

        {/* Educational / About Section */}
        {tool.about && (
          <section class="rounded-xl border border-slate-200 dark:border-[#2A2D33] bg-white dark:bg-[#131418] p-4 sm:p-6 space-y-4 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200 dark:border-[#2A2D33] pb-3">
              <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-[#8B8F98]">
                <BookOpen class="h-4 w-4 text-sky-600 dark:text-[#4F8CFF]" />
                <span>About {tool.name}</span>
              </div>
              <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono">
                {tool.about.technicalMechanism && (
                  <span class="rounded bg-sky-50 dark:bg-sky-950/40 text-sky-700 dark:text-sky-300 px-2 py-0.5 border border-sky-200 dark:border-sky-800/50">
                    {tool.about.technicalMechanism}
                  </span>
                )}
                {tool.about.supportedFormats && tool.about.supportedFormats.length > 0 && (
                  <span class="rounded bg-slate-100 dark:bg-[#1B1D22] text-slate-600 dark:text-[#8B8F98] px-2 py-0.5 border border-slate-200 dark:border-[#2A2D33]">
                    {tool.about.supportedFormats.join(', ')}
                  </span>
                )}
              </div>
            </div>
            <div class="space-y-3 text-xs sm:text-sm text-slate-600 dark:text-[#94A3B8] leading-relaxed">
              {tool.about.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </section>
        )}

        {/* Technical Specification & How-To */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
          {/* How-To Steps */}
          <section class="rounded-xl border border-slate-200 dark:border-[#2A2D33] bg-white dark:bg-[#131418] p-4 sm:p-5 space-y-3">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-[#8B8F98]">
              <Layers class="h-3.5 w-3.5 text-sky-600 dark:text-[#4F8CFF]" />
              <span>Step-by-Step Execution Guide</span>
            </div>

            <div class="space-y-2">
              {tool.howToSteps.map((step) => (
                <div class="flex items-start gap-2.5 rounded-lg bg-slate-50 dark:bg-[#1B1D22] p-2.5 border border-slate-200 dark:border-[#2A2D33]">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded bg-white dark:bg-[#131418] font-mono text-[10px] font-bold text-sky-600 dark:text-[#4F8CFF] border border-slate-200 dark:border-[#2A2D33]">
                    {step.step}
                  </span>
                  <div class="space-y-0.5 text-xs">
                    <h3 class="font-bold text-slate-900 dark:text-[#ECEDEF]">{step.title}</h3>
                    <p class="text-[11px] text-slate-600 dark:text-[#8B8F98] leading-relaxed">{step.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </section>

          {/* Feature Highlights */}
          <section class="rounded-xl border border-slate-200 dark:border-[#2A2D33] bg-white dark:bg-[#131418] p-4 sm:p-5 space-y-3">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-[#8B8F98]">
              <Terminal class="h-3.5 w-3.5 text-sky-600 dark:text-[#4F8CFF]" />
              <span>Key Features & Client Architecture</span>
            </div>

            <ul class="space-y-2 text-xs text-slate-700 dark:text-[#8B8F98]">
              {tool.features.map((feat) => (
                <li class="flex items-start gap-2 rounded-lg bg-slate-50 dark:bg-[#1B1D22] p-2.5 border border-slate-200 dark:border-[#2A2D33]">
                  <ShieldCheck class="h-4 w-4 shrink-0 text-emerald-600 dark:text-[#3FBE73] mt-0.5" />
                  <span class="text-xs font-medium text-slate-800 dark:text-[#ECEDEF]">{feat}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>

        {/* Common Practical Use Cases */}
        {tool.useCases && tool.useCases.length > 0 && (
          <section class="rounded-xl border border-slate-200 dark:border-[#2A2D33] bg-white dark:bg-[#131418] p-4 sm:p-5 space-y-3">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-[#8B8F98]">
              <Sparkles class="h-3.5 w-3.5 text-sky-600 dark:text-[#4F8CFF]" />
              <span>Common Practical Use Cases</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              {tool.useCases.map((uc) => (
                <div class="rounded-lg bg-slate-50 dark:bg-[#1B1D22] p-3.5 border border-slate-200 dark:border-[#2A2D33] space-y-1.5 flex flex-col justify-between">
                  <h4 class="text-xs font-bold text-slate-900 dark:text-[#ECEDEF] flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-sky-500 shrink-0" />
                    {uc.title}
                  </h4>
                  <p class="text-[11px] text-slate-600 dark:text-[#8B8F98] leading-relaxed flex-1">
                    {uc.description}
                  </p>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* FAQs */}
        {tool.faqs && tool.faqs.length > 0 && (
          <section class="rounded-xl border border-slate-200 dark:border-[#2A2D33] bg-white dark:bg-[#131418] p-4 sm:p-5 space-y-3">
            <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-[#8B8F98]">
              <HelpCircle class="h-3.5 w-3.5 text-sky-600 dark:text-[#4F8CFF]" />
              <span>Frequently Asked Questions (FAQ)</span>
            </div>

            <div class="space-y-2">
              {tool.faqs.map((faq) => (
                <div class="rounded-lg bg-slate-50 dark:bg-[#1B1D22] p-3 border border-slate-200 dark:border-[#2A2D33] space-y-1">
                  <h4 class="text-xs font-bold text-slate-900 dark:text-[#ECEDEF]">{faq.question}</h4>
                  <p class="text-[11px] text-slate-600 dark:text-[#8B8F98] leading-relaxed">{faq.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </div>
</Layout>
