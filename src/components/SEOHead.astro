---
export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  keywords?: string[];
  faqs?: { question: string; answer: string }[];
  howToSteps?: { step: number; title: string; desc: string }[];
  breadcrumbs?: { name: string; url: string }[];
}

const siteName = 'NovaTools';
const siteUrl = 'https://toolboxs.tech';

function normalizeUrl(rawUrl: string): string {
  try {
    const parsed = new URL(rawUrl, siteUrl);
    if (parsed.pathname === '/' || parsed.pathname === '') {
      return `${siteUrl}/`;
    }
    return `${siteUrl}${parsed.pathname.replace(/\/+$/, '')}`;
  } catch {
    return `${siteUrl}/`;
  }
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  ogType = 'website',
  ogImage = `${siteUrl}/images/suite-pdf.png`,
  keywords = ['pdf tools', 'image converter', 'video compressor', 'client-side tools', 'wasm', 'private pdf merger', 'online media tools'],
  faqs = [],
  howToSteps = [],
  breadcrumbs = [],
} = Astro.props;

const resolvedCanonical = normalizeUrl(canonicalUrl);
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

// Unified Multi-Entity Schema.org JSON-LD (Google Search Central Compliant)
const graphNodes: any[] = [
  {
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    url: `${siteUrl}/`,
    name: siteName,
    description: '100% Client-Side Privacy-First Document, Image, Video & PDF Utilities Suite',
    publisher: {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: siteName,
      url: `${siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/images/suite-pdf.png`,
      },
    },
  },
  {
    '@type': 'WebApplication',
    '@id': `${resolvedCanonical}#webapp`,
    name: fullTitle,
    url: resolvedCanonical,
    applicationCategory: 'UtilitiesApplication',
    applicationSubCategory: 'Document and Media Processing',
    operatingSystem: 'All Modern Web Browsers',
    browserRequirements: 'Requires JavaScript and WebAssembly support',
    softwareVersion: '2026.1',
    offers: {
      '@type': 'Offer',
      price: '0.00',
      priceCurrency: 'USD',
      availability: 'https://schema.org/InStock',
    },
    description: description,
  },
];

if (faqs.length > 0) {
  graphNodes.push({
    '@type': 'FAQPage',
    '@id': `${resolvedCanonical}#faq`,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  });
}

if (howToSteps.length > 0) {
  graphNodes.push({
    '@type': 'HowTo',
    '@id': `${resolvedCanonical}#howto`,
    name: `How to use ${title.replace(` | ${siteName}`, '')}`,
    description: description,
    step: howToSteps.map((s) => ({
      '@type': 'HowToStep',
      position: s.step,
      name: s.title,
      text: s.desc,
    })),
  });
}

if (breadcrumbs.length > 0) {
  graphNodes.push({
    '@type': 'BreadcrumbList',
    '@id': `${resolvedCanonical}#breadcrumbs`,
    itemListElement: breadcrumbs.map((b, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: b.name,
      item: normalizeUrl(b.url),
    })),
  });
}

const unifiedGraphSchema = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={resolvedCanonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:site_name" content={siteName} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={resolvedCanonical} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={resolvedOgImage} />

<!-- Google AdSense Account Verification -->
<meta name="google-adsense-account" content="ca-pub-6768212179657827" />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(unifiedGraphSchema)} />
