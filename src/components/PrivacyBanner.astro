---
import { Shield, Lock, Cpu } from 'lucide-react';
---

<div class="relative overflow-hidden rounded border border-[#2A2D33] bg-[#131418] p-5 sm:p-6">
  <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    <div class="space-y-1.5 max-w-2xl">
      <div class="flex items-center gap-2 text-[#3FBE73]">
        <Shield class="h-4 w-4" />
        <span class="text-[11px] font-semibold uppercase tracking-wider font-mono">Zero Network Privacy Architecture</span>
      </div>
      <h3 class="text-sm font-semibold text-[#ECEDEF]">Your confidential documents & media never leave your device</h3>
      <p class="text-xs leading-relaxed text-[#8B8F98]">
        Unlike legacy converters that upload files to cloud servers, 
        NovaTools processes transcoding, OCR speech recognition, audio normalisation, and vector rendering <strong>100% in client WebAssembly memory</strong>.
      </p>
    </div>

    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-2.5 shrink-0 text-xs text-[#8B8F98] font-mono">
      <div class="flex items-center gap-1.5 rounded border border-[#2A2D33] bg-[#1B1D22] px-3 py-1.5 text-[#ECEDEF]">
        <Lock class="h-3.5 w-3.5 text-[#3FBE73]" />
        <span>Zero Network I/O</span>
      </div>
      <div class="flex items-center gap-1.5 rounded border border-[#2A2D33] bg-[#1B1D22] px-3 py-1.5 text-[#ECEDEF]">
        <Cpu class="h-3.5 w-3.5 text-[#4F8CFF]" />
        <span>Hardware WASM</span>
      </div>
    </div>
  </div>
</div>
